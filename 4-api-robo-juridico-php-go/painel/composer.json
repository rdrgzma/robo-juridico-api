{
    "name": "robo-juridico/painel-admin",
    "type": "project",
    "description": "Painel Administrativo do Robô Jurídico construído em Laravel 13 e Filament v5",
    "keywords": ["laravel", "filament", "admin", "robo-juridico", "juridico-api"],
    "license": "MIT",
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "filament/filament": "^3.2|^4.0|^5.0",
        "laravel/framework": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
