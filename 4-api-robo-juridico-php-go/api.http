# ==============================================================================
# REST Client para VS Code — Robô Jurídico API (Go + Laravel Filament)
# ==============================================================================
# Instruções:
# 1. Instale a extensão "REST Client" (por Huachao Mao) no VS Code.
# 2. Substitua o valor da variável @chave abaixo pela chave copiada no Portal ou Admin.
# 3. Clique em "Send Request" que aparece logo acima de cada método HTTP.
# ==============================================================================

@base = http://localhost:8000
@chave = rj_live_SUA_CHAVE_AQUI

### 1. Healthcheck da API (Livre, sem chave)
GET {{base}}/saude
Accept: application/json

### 2. Especificação OpenAPI JSON (Livre, sem chave)
GET {{base}}/openapi.json
Accept: application/json

### 3. Minha Conta e Saldo de Cota (Grátis, requer chave)
GET {{base}}/v1/conta
X-API-Key: {{chave}}
Accept: application/json

### 4. Decodificação Matemática e Validação de CNJ (Grátis, requer chave)
GET {{base}}/v1/cnj/5010754-07.2024.8.13.0625
X-API-Key: {{chave}}
Accept: application/json

### 5. Checagem Rápida de Existência de Processo (Grátis, requer chave)
GET {{base}}/v1/processos/5010754-07.2024.8.13.0625/existe
X-API-Key: {{chave}}
Accept: application/json

### 6. Consulta Completa de Processo — DataJud + DJEN (Consome 1 cota)
GET {{base}}/v1/processos/5010754-07.2024.8.13.0625
X-API-Key: {{chave}}
Accept: application/json

### 7. Consulta Rápida de Processo — Apenas Diário DJEN (Consome 1 cota)
GET {{base}}/v1/processos/5010754-07.2024.8.13.0625?modo=rapido
X-API-Key: {{chave}}
Accept: application/json

### 8. Consulta de Processo via POST com Body JSON (Consome 1 cota)
POST {{base}}/v1/processos/consultar
Authorization: Bearer {{chave}}
Content-Type: application/json
Accept: application/json

{
  "numero_processo": "5010754-07.2024.8.13.0625",
  "modo": "completo"
}

### 9. Publicações do Diário Oficial por OAB — Controle de Prazos (Consome 1 cota)
GET {{base}}/v1/oab/MG/123456/publicacoes?dias=7&paginas=1
X-API-Key: {{chave}}
Accept: application/json

### 10. Processos Publicados por OAB no Período (Consome 1 cota)
GET {{base}}/v1/oab/MG/123456/processos?dias=30&tribunal=TJMG
X-API-Key: {{chave}}
Accept: application/json

### 11. Listar Índices e Séries Disponíveis (Grátis, requer chave)
GET {{base}}/v1/calculos/indices
X-API-Key: {{chave}}
Accept: application/json

### 12. Obter Série Histórica de um Índice (Grátis, requer chave)
GET {{base}}/v1/calculos/indices/TJSP/serie
X-API-Key: {{chave}}
Accept: application/json

### 13. Executar Liquidação de Débito Judicial (Padrão TJSP + Juros + Art. 523 CPC)
POST {{base}}/v1/calculos/judicial
X-API-Key: {{chave}}
Content-Type: application/json
Accept: application/json

{
  "numero_processo": "1002345-67.2023.8.26.0100",
  "data_atualizacao": "2026-10-14",
  "indexador_codigo": "TJSP",
  "aplicar_deflacao": true,
  "juros_mora": {
    "tipo": "CONVENCIONAL_MENSAL",
    "percentual_mensal": 1.0,
    "modo": "COMPOSTO",
    "aplicar_prorata_die": true
  },
  "fase_execucao": {
    "aplicar_art_523_multa": true,
    "aplicar_art_523_honorarios": true,
    "multa_moratoria_percentual": 10.0
  },
  "parcelas": [
    {
      "numero_item": 1,
      "descricao": "Parcela Inicial de Débito",
      "tipo": "DEBITO",
      "data_vencimento": "2023-01-15",
      "valor_original": 10000.00
    },
    {
      "numero_item": 2,
      "descricao": "Custas Iniciais",
      "tipo": "CUSTA_PROCESSUAL",
      "data_vencimento": "2023-01-20",
      "valor_original": 350.00
    }
  ]
}

### 14. Liquidação Judicial pela Nova Lei 14.905/2024 (IPCA + Taxa Legal Bacen)
POST {{base}}/v1/calculos/judicial
X-API-Key: {{chave}}
Content-Type: application/json
Accept: application/json

{
  "numero_processo": "5010754-07.2024.8.13.0625",
  "data_atualizacao": "2026-10-14",
  "indexador_codigo": "IPCA",
  "aplicar_deflacao": true,
  "juros_mora": {
    "tipo": "TAXA_LEGAL",
    "percentual_mensal": 1.0,
    "modo": "SIMPLES",
    "aplicar_prorata_die": true
  },
  "fase_execucao": {
    "aplicar_art_523_multa": true,
    "aplicar_art_523_honorarios": true
  },
  "parcelas": [
    {
      "numero_item": 1,
      "descricao": "Danos Morais e Materiais",
      "tipo": "DEBITO",
      "data_vencimento": "2024-02-15",
      "valor_original": 25000.00
    },
    {
      "numero_item": 2,
      "descricao": "Amortização Espontânea Parcial",
      "tipo": "PAGAMENTO_PARCIAL",
      "data_vencimento": "2025-05-10",
      "valor_original": -5000.00
    }
  ]
}

### 15. Disparar Coleta / Sincronização Manual dos Índices (Bacen, IBGE, Tribunais)
POST {{base}}/v1/calculos/coletar
X-API-Key: {{chave}}
Accept: application/json

### 16. Consultar Status do Worker de Coleta de Índices
GET {{base}}/v1/calculos/coletar/status
X-API-Key: {{chave}}
Accept: application/json

### 17. Liquidação Judicial com Imputação pelo Art. 354 CC, Juros Compensatórios e Correção Pro Rata Die
POST {{base}}/v1/calculos/judicial
X-API-Key: {{chave}}
Content-Type: application/json
Accept: application/json

{
  "numero_processo": "5010754-07.2024.8.13.0625",
  "data_atualizacao": "2026-10-14",
  "indexador_codigo": "TJMG",
  "aplicar_deflacao": true,
  "aplicar_prorata_correcao": true,
  "imputar_art_354_cc": true,
  "juros_mora": {
    "tipo": "TAXA_LEGAL",
    "percentual_mensal": 1.0,
    "modo": "SIMPLES",
    "aplicar_prorata_die": true
  },
  "juros_compensatorios": {
    "aplicar": true,
    "taxa_mensal": 0.5,
    "modo": "SIMPLES"
  },
  "parcelas": [
    {
      "numero_item": 1,
      "descricao": "Condenação Principal",
      "tipo": "DEBITO",
      "data_vencimento": "2024-01-15",
      "valor_original": 20000.00
    },
    {
      "numero_item": 2,
      "descricao": "Amortização Parcial (Art. 354 CC)",
      "tipo": "PAGAMENTO_PARCIAL",
      "data_vencimento": "2025-01-15",
      "valor_original": 4000.00
    }
  ]
}

### 18. Exportar Memória de Cálculo em Excel (.xlsx) ou CSV (.csv)
POST {{base}}/v1/calculos/exportar-planilha?formato=xlsx
X-API-Key: {{chave}}
Content-Type: application/json

{
  "numero_processo": "1002345-67.2023.8.26.0100",
  "data_atualizacao": "2026-10-14",
  "indexador_codigo": "TJSP",
  "juros_mora": {
    "tipo": "CONVENCIONAL_MENSAL",
    "percentual_mensal": 1.0,
    "modo": "SIMPLES",
    "aplicar_prorata_die": true
  },
  "parcelas": [
    {
      "numero_item": 1,
      "descricao": "Principal",
      "tipo": "DEBITO",
      "data_vencimento": "2024-01-15",
      "valor_original": 10000.00
    }
  ]
}

### 19. Revisão de Contrato Bancário (Tabela Price vs Método de Gauss + Art. 42 CDC)
POST {{base}}/v1/calculos/financiamento
X-API-Key: {{chave}}
Content-Type: application/json
Accept: application/json

{
  "valor_financiado": 50000.00,
  "quantidade_parcelas": 36,
  "taxa_mensal_contrato": 2.49,
  "taxa_mensal_mercado": 1.45,
  "sistema_contratado": "PRICE",
  "sistema_revisado": "GAUSS",
  "parcelas_pagas": 18,
  "data_primeira_parcela": "2024-01-15"
}

### 20. Calculadora de Prazos Processuais Fatais (CPC/2015 Art. 224 e Recesso Art. 220)
POST {{base}}/v1/prazos/calcular
X-API-Key: {{chave}}
Content-Type: application/json
Accept: application/json

{
  "data_referencia": "2026-05-04",
  "tipo_evento": "DISPONIBILIZACAO_DJE",
  "quantidade_dias": 15,
  "contagem": "DIAS_UTEIS",
  "rito": "CPC",
  "prazo_em_dobro": false,
  "suspender_recesso": true,
  "uf": "SP"
}

### 21. Consultar Feriados Nacionais, Móveis e Forenses do Ano
GET {{base}}/v1/prazos/feriados?ano=2026
X-API-Key: {{chave}}
Accept: application/json

### 22. Cadastrar Webhook de Monitoramento Push (Processo ou OAB)
POST {{base}}/v1/webhooks
X-API-Key: {{chave}}
Content-Type: application/json
Accept: application/json

{
  "cliente": "Escritório Silva",
  "url_destino": "https://meuerp.com.br/webhooks/intimacoes",
  "segredo_hmac": "segredo-super-seguro-2026",
  "tipo_monitoramento": "OAB",
  "filtro_valor": "MG123456"
}

### 23. Listar Webhooks de Monitoramento Push
GET {{base}}/v1/webhooks
X-API-Key: {{chave}}
Accept: application/json

### 24. Simular Disparo de Webhook Push com Assinatura HMAC-SHA256
POST {{base}}/v1/webhooks/testar
X-API-Key: {{chave}}
Content-Type: application/json
Accept: application/json

{
  "segredo_hmac": "segredo-super-seguro-2026",
  "evento": "nova_publicacao_djen",
  "processo": "5010754-07.2024.8.13.0625"
}

